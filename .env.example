APP_NAME="AGR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.ee

APP_LOCALE=et
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agrBase
DB_USERNAME=agr
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Отправка отчётов на e-mail объекта (кнопка «Saada»). Пока не настроено — письма пишутся в storage/logs (MAIL_MAILER=log)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="aruanded@example.ee"
MAIL_FROM_NAME="AGR"
